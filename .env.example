# Pipeline strategy: cascade (rules -> Laya -> LLM), rule_based, laya, or llm.
EMAIL_CLASSIFIER_MODE=cascade

# Used by cascade's final fallback and llm mode; selects the hosted provider.
EMAIL_LLM_PROVIDER=nvidia
EMAIL_LLM_TIMEOUT=60
EMAIL_LLM_MAX_INPUT_CHARS=50000
EMAIL_LLM_MAX_OUTPUT_TOKENS=1024

NVIDIA_API_KEY=
# Choose a deployed instruction model supporting guided_json.
NVIDIA_MODEL=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta

HF_TOKEN=
# Set a served model ID; optionally suffix :provider to pin a backend.
# The selected model/backend must support strict JSON-schema output.
HF_MODEL=
HF_BASE_URL=https://router.huggingface.co/v1

# Local Laya; public model requires no API key. HF_TOKEN is optional.
LAYA_CHECKPOINT=auto
LAYA_DEVICE=cpu
LAYA_CACHE_DIR=.cache/laya
LAYA_LOCAL_FILES_ONLY=false
LAYA_MIN_PROBABILITY=0.80
LAYA_MIN_MARGIN=0.20
LAYA_MIN_ACT_PROBABILITY=0.50
LAYA_MAX_INPUT_CHARS=50000

# Local web UI: folder containing inbox/ and attachments/, or organizer HTTP URL.
AVERIS_INBOX_SOURCE="Averis Hackathon Instruction/sdoc-hackathon-docker/data_v2"
# Durable case results and human review state. Run the API with one worker.
AVERIS_UI_STATE=.cache/ui-state.sqlite3
# Manually composed emails and their uploaded attachments (kept separate from
# AVERIS_INBOX_SOURCE, which may be read-only or an organizer HTTP URL).
AVERIS_MANUAL_UPLOADS=.cache/manual-uploads
